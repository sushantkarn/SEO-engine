{
  "name": "@gmbranker/seo-engine-cli",
  "version": "0.2.8",
  "description": "CLI for SEO audits and validation in CI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sushantkarn/SEO-engine.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/sushantkarn/SEO-engine#readme",
  "bugs": {
    "url": "https://github.com/sushantkarn/SEO-engine/issues"
  },
  "keywords": [
    "seo",
    "cli",
    "audit",
    "ci"
  ],
  "publishConfig": {
