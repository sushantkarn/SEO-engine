{
  "name": "@seo-engine/core",
  "version": "0.1.0",
  "description": "Framework-agnostic SEO engine — metadata, schema, sitemap helpers, robots.txt, llms.txt, and content analysis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sushantkarn/SEO-engine.git",
    "directory": "packages/seo-engine"
  },
  "homepage": "https://github.com/sushantkarn/SEO-engine#readme",
  "bugs": {
    "url": "https://github.com/sushantkarn/SEO-engine/issues"
  },
  "keywords": ["seo", "nextjs", "metadata", "json-ld", "robots-txt", "sitemap", "llms-txt", "mcp"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
